.text
	#sequencia de raios antes do logo
	la a0, mkraio1
	li a1,1
	call loadimage
	
	li a0,65
	li a1,6
	call piscadelas
	
	li a0,700
	li a7,32
	ecall
	
	la a0, mkraio2
