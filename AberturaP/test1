	li a7,10  
	ecall
	#-------------------- END -----------------
	
	
	
	#a0 tempo de cada piscada em millisegundos.
	#a1 número de piscadas.
	piscadela:
	addi sp,sp,-4
	sw t1,0(sp)
	
	li s0,0xFF200604	# Escolhe o Frame 0 ou 1
	li t2,0			# inicio Frame 0
LOOP1piscadela: 
	beqz a1,ENDpiscadela
	addi a1,a1,-1
	sw t2,0(s0)		# seleciona a Frame t2
	xori t2,t2,0x001	# troca de frame
	
	li a7,32
	ecall
	j LOOP1piscadela
ENDpiscadela:
	sw t2,0(s0)		# seleciona a Frame t2
	
	lw t1,0(sp)
	addi sp,sp,4
	ret
		
	
		
	# transforma bitmap_display em 0xC7
	# a0(frame) -> 
	loadimage:
        beqz    a1,.L4
        li      a3,-15650816 
        addi    a3,a3,-1024
        li      a5,-15728640
.L2:
        addi    a0,a0,8
.L3:
        lw      a4,0(a0)
        addi    a5,a5,4
        addi    a0,a0,4
        sw      a4,-4(a5)
        bgtu    a3,a5,.L3
        ret
.L4:
        li      a3,-16699392
        addi    a3,a3,-1024
        li      a5,-16777216
        j       .L2
